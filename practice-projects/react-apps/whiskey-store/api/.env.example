# Copy to api/.env for local development. In production, set the same keys in
# the Render dashboard (Environment tab) — never commit the real values.

# Postgres. Neon: use the DIRECT connection string (not the "-pooler" one),
# ending in ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/whiskey

# Two different random strings, 32+ characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Stripe (test mode): Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: the signing secret of the webhook endpoint you create in the Dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where the React app runs, no trailing slash. Comma-separate several.
# Production example: https://dramshop.yourname.dev,https://dramshop.vercel.app
CLIENT_URL=http://localhost:5173

# production on Render; leave unset locally
# NODE_ENV=production
# Render sets PORT itself
# PORT=3000
